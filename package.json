{
  "name": "fieldnote-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "local:db": "node scripts/local-mongo.mjs",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.1",
    "mongodb-memory-server-core": "^11.4.0"
  }
}
